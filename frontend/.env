# The dev server's API base URL is derived from RINGRPQ_BACKEND_PORT /
# ports.conf by vite.config.js, so the backend's port is set in one place.
# Uncomment to point the dev build at a backend somewhere else entirely;
# vite.config.js checks this file first, so an explicit value here wins over
# the one derived from ports.conf.
# VITE_API_BASE_URL=http://localhost:8000
