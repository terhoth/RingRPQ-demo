[Unit]
Description=XPathRingRPQ translation service (Spring Boot)
After=network.target
PartOf=ringrpq.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/XPathRingRPQ
# Exported for anything in the process that wants it; the port itself is set
# on the command line below, not from here.
Environment=RINGRPQ_XPATH_PORT=@XPATH_PORT@
# The packaged jar, not `mvnw spring-boot:run` — that forks a child JVM that
# systemd can't track, and needs a writable Maven repo at runtime.
# Build it first: ./mvnw -DskipTests package
#
# --server.port is a command-line argument, the highest-precedence source in
# Spring's property order, and crucially one that does not live inside the
# jar. application.properties is compiled into BOOT-INF/classes at package
# time, so relying on its server.port=${RINGRPQ_XPATH_PORT:8080} would make
# every port change require `./mvnw package` first — and silently keep
# serving the old port until someone did.
ExecStart=@JAVA@ -jar @REPO@/XPathRingRPQ/target/demo-0.0.1-SNAPSHOT.jar --server.port=@XPATH_PORT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=ringrpq.target
