DATABASE_URL=postgresql+psycopg2://ringrpq:ringrpq@localhost:5432/ringrpq
# The XPathRingRPQ service's URL. Normally left commented out: it is derived
# from RINGRPQ_XPATH_PORT / ports.conf on localhost (see app/config.py), so
# the port is only set in one place. Uncomment to point at another host.
# XPATHRINGRPQ_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
# Development only: also accept any http://localhost:<port> origin, for when
# Vite walks past 5173. Leave unset/false on a server.
ALLOW_LOCALHOST_ORIGINS=true
# Optional: override the Ring-RPQ database folder (default: Ring-RPQ/data/).
# Prefer setting this once in Ring-RPQ/data-dir.conf instead (shared with
# run-workers.sh / ring-rpq-worker) — only set it here if you specifically
# need the backend pointed somewhere different from the workers.
# RING_RPQ_DATA_DIR=/path/to/external/data